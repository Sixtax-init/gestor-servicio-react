# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

#scripts
/scripts/*
!/scripts/setup-complete-db.sql
!/scripts/003-add-reset-token.sql
# Las migraciones sueltas NNN-*.sql / rNNN-*.sql NO se versionan: son trabajo
# transitorio que se integra a setup-complete-db.sql una vez validado (ver §5
# de PRODUCCION.md). Este script es la excepción porque no es una migración de
# esquema: el servidor lo necesita para mover los archivos ya subidos fuera de
# public/ y no puede consolidarse en un .sql.
!/scripts/migrate-uploads-privados.js
/docs

# archivos privados de alumnos — fuera de public/, nunca se versionan
/private-uploads/

#public
public/*
!public/
public/logos/*
!public/logos/
!public/logos/original.png

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# Excepción: la configuración de las pruebas sí se versiona. No contiene
# secretos reales —apunta a la base desechable del contenedor de pruebas y usa
# un SESSION_SECRET de juguete— y sin ella ni el equipo ni el CI pueden correr
# la suite.
!.env.test

# lock file de npm (el proyecto usa pnpm)
package-lock.json

# vercel
.vercel

# producción (checklist local, no subir)
PRODUCCION.md

# typescript
*.tsbuildinfo
next-env.d.ts

#postman
postman/*
# pruebas
/test-results/
/playwright-report/
/tests/setup/datos-sembrados.json
AGENTS.md
CLAUDE.md