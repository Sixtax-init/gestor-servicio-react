# Configuración exclusiva de la suite de pruebas.
# La base vive en el contenedor de docker-compose.test.yml (puerto 5434):
# es efímera y NO es la de desarrollo.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/gestor_horas_test

# Puerto donde Playwright levanta la app; distinto del 3000 de desarrollo para
# poder tener ambos corriendo a la vez.
TEST_PORT=3100

# Secreto de sesión sólo para pruebas. No es sensible: la base es desechable.
SESSION_SECRET=secreto_solo_para_pruebas_con_mas_de_32_caracteres
